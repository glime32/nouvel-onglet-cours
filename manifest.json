{
  "manifest_version": 3,
  "name": "Nouvel onglet : mes cours",
  "description": "Mes cours Moodle UM en un clic, dans le style du portfolio. Mode révision, connexion CAS automatique, bouton « Tout télécharger » sur Moodle.",
  "version": "1.3.0",
  "permissions": [
    "favicon",
    "storage",
    "alarms",
    "tabs",
    "tabGroups",
    "webNavigation",
    "notifications",
    "declarativeNetRequest",
    "nativeMessaging",
    "downloads",
    "idle"
  ],
  "host_permissions": [
    "https://moodle.umontpellier.fr/*",
    "https://cas.umontpellier.fr/*",
    "https://app.umontpellier.fr/*"
  ],
  "background": {
    "service_worker": "fond.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cas.umontpellier.fr/*"
      ],
      "js": [
        "fac-cas.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://moodle.umontpellier.fr/*"
      ],
      "js": [
        "cours.js",
        "fac-moodle.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.umontpellier.fr/prose-etudiant/*"
      ],
      "js": [
        "fac-prose.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "128": "icone.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
