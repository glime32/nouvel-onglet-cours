{
  "manifest_version": 3,
  "name": "Nouvel onglet : mes cours",
  "description": "Mes cours Moodle UM en un clic, dans le style du portfolio. Mode révision, connexion CAS automatique, bouton « Tout télécharger » sur Moodle.",
  "version": "1.6.0",
  "permissions": [
    "favicon",
    "storage",
    "alarms",
    "tabs",
    "tabGroups",
    "scripting",
    "webNavigation",
    "notifications",
    "declarativeNetRequest",
    "nativeMessaging",
    "downloads",
    "idle"
  ],
  "host_permissions": [
    "https://moodle.umontpellier.fr/*",
    "https://cas.umontpellier.fr/*",
    "https://app.umontpellier.fr/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "fond.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://proseconsult.umontpellier.fr/direct/*"
      ],
      "js": [
        "fac-prose-copie.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://cas.umontpellier.fr/*"
      ],
      "js": [
        "fac-cas.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://moodle.umontpellier.fr/*"
      ],
      "js": [
        "cours.js",
        "fac-moodle.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.umontpellier.fr/prose-etudiant/*"
      ],
      "js": [
        "fac-prose.js"
      ],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "fac",
        "enabled": true,
        "path": "regles-fac.json"
      }
    ]
  },
  "icons": {
    "128": "icone.png"
  },
  "web_accessible_resources": [
    { "resources": ["connexion.html"], "matches": ["https://moodle.umontpellier.fr/*"] }
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "Tri YouTube",
    "default_popup": "youtube.html"
  }
}
